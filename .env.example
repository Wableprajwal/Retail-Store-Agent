# Copy this file to .env and fill in ONE provider.
# If LLM_PROVIDER is unset, the agent auto-detects:
#   ANTHROPIC_API_KEY set -> anthropic, else OPENAI_API_KEY set -> openai, else ollama.

# LLM_PROVIDER=anthropic        # anthropic | openai | ollama

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (ChatGPT) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Google Gemini (free key: https://aistudio.google.com/apikey) ---
# GEMINI_API_KEY=AQ....
# GEMINI_MODEL=gemini-2.5-flash

# --- Local (Ollama) — no key needed, just `ollama serve` ---
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
